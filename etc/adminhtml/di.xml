<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        Adds the Attachments fieldset to the product edit form. The pool is a
        virtualType declared by Magento_Catalog; adding an item to its
        `modifiers` argument merges, it does not replace.
    -->
    <virtualType name="Magento\Catalog\Ui\DataProvider\Product\Form\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="magenx_product_attachments" xsi:type="array">
                    <item name="class" xsi:type="string">Magenx\ProductAttachments\Ui\DataProvider\Product\Form\Modifier\Attachments</item>
                    <item name="sortOrder" xsi:type="number">160</item>
                </item>
            </argument>
        </arguments>
    </virtualType>
</config>
